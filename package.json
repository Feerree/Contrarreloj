{
  "name": "contrarreloj",
  "version": "1.0.0",
  "private": true,
  "description": "Juego de descripción por equipos inspirado en Trivia Contrarreloj. PWA offline.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-bank.mjs && node tools/build-sw.mjs",
    "bank": "node tools/build-bank.mjs",
    "bank:check": "node tools/build-bank.mjs --check",
    "bank:strict": "node tools/build-bank.mjs --check --strict",
    "icons": "node tools/build-icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "start": "npx --yes serve app -l 5173"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
